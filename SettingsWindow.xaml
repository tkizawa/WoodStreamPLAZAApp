<Window x:Class="WoodStreamPlaza.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Settings_Title}"
        Width="520" Height="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F8FAFC"
        FontFamily="{StaticResource AppFont}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- タイトル見出し -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{DynamicResource Settings_Title}" FontSize="18" FontWeight="Bold" Foreground="#0F172A" />
            <TextBlock Text="{DynamicResource Settings_General}" FontSize="12" Foreground="#64748B" Margin="0,4,0,0" />
        </StackPanel>

        <!-- 設定項目一覧 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 表示言語 -->
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings_Language}" FontWeight="SemiBold" FontSize="13" Foreground="#1E293B" />
                        <ComboBox x:Name="LanguageComboBox" Margin="0,8,0,0" Height="32" VerticalContentAlignment="Center">
                            <ComboBoxItem Tag="auto" Content="{DynamicResource Settings_Language_Auto}" />
                            <ComboBoxItem Tag="ja-JP" Content="{DynamicResource Settings_Language_Ja}" />
                            <ComboBoxItem Tag="en-US" Content="{DynamicResource Settings_Language_En}" />
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- 起動時URL -->
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings_StartUrl}" FontWeight="SemiBold" FontSize="13" Foreground="#1E293B" />
                        <TextBox x:Name="StartUrlTextBox" Margin="0,8,0,0" Height="32" VerticalContentAlignment="Center" Padding="6,0" BorderBrush="#CBD5E1" />
                    </StackPanel>
                </Border>

                <!-- 動作設定 -->
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings_Behavior}" FontWeight="SemiBold" FontSize="13" Foreground="#1E293B" Margin="0,0,0,8" />
                        <CheckBox x:Name="MinimizeToTrayCheckBox" Content="{DynamicResource Settings_MinimizeToTray}" Margin="0,4" />
                        <CheckBox x:Name="CloseToTrayCheckBox" Content="{DynamicResource Settings_CloseToTray}" Margin="0,4" />
                        <CheckBox x:Name="AutoStartCheckBox" Content="{DynamicResource Settings_AutoStart}" Margin="0,4" />
                        <CheckBox x:Name="StartMinimizedCheckBox" Content="{DynamicResource Settings_StartMinimized}" Margin="0,4" />
                        <CheckBox x:Name="EnableNotificationsCheckBox" Content="{DynamicResource Settings_EnableNotifications}" Margin="0,4" />
                        <CheckBox x:Name="ShowNavBarCheckBox" Content="{DynamicResource Settings_ShowNavBar}" Margin="0,4" />
                    </StackPanel>
                </Border>

                <!-- キャッシュ管理 -->
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings_ClearCache}" FontWeight="SemiBold" FontSize="13" Foreground="#1E293B" />
                        <TextBlock Text="{DynamicResource Settings_ClearCache_Desc}" FontSize="12" Foreground="#64748B" Margin="0,4,0,8" TextWrapping="Wrap" />
                        <Button x:Name="ClearCacheButton" Content="{DynamicResource Settings_ClearCache_Btn}" Style="{StaticResource NavButtonStyle}" HorizontalAlignment="Left" Click="ClearCacheButton_Click" Padding="12,6" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ボタン領域 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{DynamicResource Settings_Cancel}" Width="90" Height="34" Margin="0,0,8,0" Style="{StaticResource NavButtonStyle}" Click="CancelButton_Click" IsCancel="True" />
            <Button Content="{DynamicResource Settings_Save}" Width="90" Height="34" Style="{StaticResource PrimaryButtonStyle}" Click="SaveButton_Click" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
