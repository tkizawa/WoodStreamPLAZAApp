<Window x:Class="WoodStreamPlaza.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Help_Title}"
        Width="680" Height="650"
        MinWidth="500" MinHeight="450"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F8FAFC"
        FontFamily="{StaticResource AppFont}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- ヘッダー (アプリ名・バージョン) -->
            <RowDefinition Height="Auto" />
            <!-- 操作説明コンテンツ -->
            <RowDefinition Height="*" />
            <!-- フッター (閉じるボタン) -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- アプリアイコン -->
                <Image Grid.Column="0" Source="/app.ico" Width="48" Height="48" Margin="0,0,16,0" VerticalAlignment="Center" />

                <!-- アプリ情報 & バージョン -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="WoodStream PLAZA" FontSize="18" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                        <!-- バージョン番号バッジ -->
                        <Border Background="#EEF2F6" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="12" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="VersionTextBlock" Text="Version 1.0.0.0" FontSize="11" FontWeight="SemiBold" Foreground="#2563EB" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="ポッドキャスト番組WoodStreamのデジタル生活 リスナーコミュニティ クライアント" FontSize="11" Foreground="#64748B" Margin="0,3,0,0" />
                    <TextBlock Text="Copyright © 2026 WoodStream Networks Tomokazu Kizawa. All rights reserved." FontSize="10" Foreground="#94A3B8" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 操作説明コンテンツ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">

                <!-- 1. クイックナビゲーションバー -->
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="🧭 上部クイックナビゲーションバーの操作" FontWeight="Bold" FontSize="14" Foreground="#1E293B" Margin="0,0,0,8" />
                        <TextBlock Text="アプリ最上部のナビゲーションバーから、主要な操作や各ルームへワンクリックでアクセスできます。" FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,8" />
                        
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="◀ / ▶ / ⟳ / 🏠" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,3" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="戻る・進む・現在のページ再読み込み・ホーム（PLAZAトップ）へ移動" FontSize="12" Foreground="#64748B" Margin="0,3" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="本館ルーム" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,3" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="「📢 お知らせ」「🛋️ ラウンジ」「📻 番組感想」へ即座に移動" FontSize="12" Foreground="#64748B" Margin="0,3" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="別館 木澤屋" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,3" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="「📺 エンタメ」「🍜 食テロ・日常」「🎨 AI生成画像」へ即座に移動" FontSize="12" Foreground="#64748B" Margin="0,3" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="- / 100% / +" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,3" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="画面のズーム倍率を 50% 〜 300% の範囲で縮小・リセット・拡大" FontSize="12" Foreground="#64748B" Margin="0,3" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="❓ / ⚙" FontWeight="SemiBold" FontSize="12" Foreground="#334155" Margin="0,3" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="操作説明書の表示 / アプリケーション設定画面の表示" FontSize="12" Foreground="#64748B" Margin="0,3" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 2. Windows ネイティブトースト通知 & タスクバーバッジ -->
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="🔔 新着通知 &amp; 🔴 タスクバー未読バッジ" FontWeight="Bold" FontSize="14" Foreground="#1E293B" Margin="0,0,0,8" />
                        
                        <TextBlock Text="■ Windows トースト通知" FontWeight="SemiBold" FontSize="12" Foreground="#0F172A" Margin="0,2,0,2" />
                        <TextBlock Text="あなたへのメンション（@表示名）、投稿への返信、いいね！を受信すると、Windows 10/11 のトースト通知が画面右下にポップアップします。通知をクリックするとアプリが自動的に最前面に復元し、通知メニューを開きます。" FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,8" />

                        <TextBlock Text="■ タスクバー未読バッジ" FontWeight="SemiBold" FontSize="12" Foreground="#0F172A" Margin="0,4,0,2" />
                        <TextBlock Text="タスクバーのアプリアイコン右下に、未読件数（1〜99+）に応じた赤い数字バッジが表示されます。未読をすべて確認すると自動的にクリアされます。" FontSize="12" Foreground="#475569" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 3. タスクトレイ常駐機能 -->
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="📥 タスクトレイ常駐（Discord / Teams 風の動作）" FontWeight="Bold" FontSize="14" Foreground="#1E293B" Margin="0,0,0,8" />
                        <TextBlock Text="アプリを閉じてもバックグラウンドで待機し、新着通知をリアルタイムに受け取ることができます。" FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,6" />

                        <BulletDecorator Margin="0,2">
                            <BulletDecorator.Bullet>
                                <Ellipse Width="4" Height="4" Fill="#3B82F6" Margin="0,5,8,0" />
                            </BulletDecorator.Bullet>
                            <TextBlock Text="最小化時: タスクバーから消え、画面右下のタスクトレイに格納されます。" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" />
                        </BulletDecorator>

                        <BulletDecorator Margin="0,2">
                            <BulletDecorator.Bullet>
                                <Ellipse Width="4" Height="4" Fill="#3B82F6" Margin="0,5,8,0" />
                            </BulletDecorator.Bullet>
                            <TextBlock Text="「×」ボタン押下時: 終了せずトレイに格納されます（設定でオン/オフ可能）。" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" />
                        </BulletDecorator>

                        <BulletDecorator Margin="0,2">
                            <BulletDecorator.Bullet>
                                <Ellipse Width="4" Height="4" Fill="#3B82F6" Margin="0,5,8,0" />
                            </BulletDecorator.Bullet>
                            <TextBlock Text="トレイアイコン左クリック / ダブルクリック: アプリを即座に最前面へ復元。" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" />
                        </BulletDecorator>

                        <BulletDecorator Margin="0,2">
                            <BulletDecorator.Bullet>
                                <Ellipse Width="4" Height="4" Fill="#3B82F6" Margin="0,5,8,0" />
                            </BulletDecorator.Bullet>
                            <TextBlock Text="トレイ右クリックメニュー: 「開く」「ページの再読み込み」「設定...」「終了」を選択可能。" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" />
                        </BulletDecorator>
                    </StackPanel>
                </Border>

                <!-- 4. 設定画面 (⚙) -->
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="⚙ 設定画面のカスタマイズ" FontWeight="Bold" FontSize="14" Foreground="#1E293B" Margin="0,0,0,8" />
                        <TextBlock Text="ナビゲーションバーの「⚙」ボタンから、以下の動作をいつでも変更できます：" FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBlock Text="• 表示言語（Windows自動 / 日本語 / 英語）&#x0a;• 起動時URLの指定&#x0a;• 最小化時にタスクトレイに格納&#x0a;• 「閉じる」ボタンで終了せずタスクトレイに常駐&#x0a;• 新着通知（返信・メンション等）のトースト表示オン/オフ&#x0a;• 上部ナビゲーションバーの表示/非表示&#x0a;• ブラウザキャッシュクリア" FontSize="12" Foreground="#64748B" LineHeight="20" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- フッター (閉じるボタン) -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{DynamicResource Help_Close}" Width="100" Height="34" Style="{StaticResource PrimaryButtonStyle}" Click="CloseButton_Click" IsDefault="True" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
