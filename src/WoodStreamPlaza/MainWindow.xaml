<Window x:Class="WoodStreamPlaza.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="{DynamicResource App_Title}"
        Width="1200" Height="850"
        MinWidth="800" MinHeight="600"
        Icon="app.ico"
        Background="#F1F5F9"
        FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <!-- 上部クイックナビゲーションバー -->
            <RowDefinition Height="Auto" x:Name="NavBarRow" />
            <!-- WebView2 メインコンテンツエリア -->
            <RowDefinition Height="*" />
            <!-- ステータス／ロード進行バー -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 上部ナビゲーションツールバー -->
        <Border Grid.Row="0"
                Background="{StaticResource BgHeaderBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- ブラウザ基本操作（戻る、進む、更新、ホーム） -->
                    <ColumnDefinition Width="Auto" />
                    <!-- ルームクイックアクセスボタン群 -->
                    <ColumnDefinition Width="*" />
                    <!-- ズーム & 設定ボタン -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 基本操作 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,0">
                    <Button x:Name="BackButton" Content="◀" ToolTip="{DynamicResource Nav_Back}" Width="32" Height="30" Margin="0,0,4,0" Style="{StaticResource NavButtonStyle}" Click="BackButton_Click" />
                    <Button x:Name="ForwardButton" Content="▶" ToolTip="{DynamicResource Nav_Forward}" Width="32" Height="30" Margin="0,0,4,0" Style="{StaticResource NavButtonStyle}" Click="ForwardButton_Click" />
                    <Button x:Name="ReloadButton" Content="⟳" ToolTip="{DynamicResource Nav_Reload}" Width="32" Height="30" Margin="0,0,4,0" Style="{StaticResource NavButtonStyle}" Click="ReloadButton_Click" />
                    <Button x:Name="HomeButton" Content="🏠" ToolTip="{DynamicResource Nav_Home}" Width="32" Height="30" Style="{StaticResource NavButtonStyle}" Click="HomeButton_Click" />
                </StackPanel>

                <!-- ルーム切り替えクイックボタン (横スクロール対応) -->
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="本館:" VerticalAlignment="Center" FontSize="11" Foreground="#64748B" FontWeight="Bold" Margin="4,0,6,0" />
                        <Button Content="{DynamicResource Nav_Notice}" Margin="0,0,4,0" Style="{StaticResource RoomButtonStyle}" Click="RoomNotice_Click" />
                        <Button Content="{DynamicResource Nav_Lounge}" Margin="0,0,4,0" Style="{StaticResource RoomButtonStyle}" Click="RoomLounge_Click" />
                        <Button Content="{DynamicResource Nav_Episodes}" Margin="0,0,8,0" Style="{StaticResource RoomButtonStyle}" Click="RoomEpisodes_Click" />

                        <TextBlock Text="別館:" VerticalAlignment="Center" FontSize="11" Foreground="#64748B" FontWeight="Bold" Margin="4,0,6,0" />
                        <Button Content="{DynamicResource Nav_Entertainment}" Margin="0,0,4,0" Style="{StaticResource RoomButtonStyle}" Click="RoomEntertainment_Click" />
                        <Button Content="{DynamicResource Nav_Gourmet}" Margin="0,0,4,0" Style="{StaticResource RoomButtonStyle}" Click="RoomGourmet_Click" />
                        <Button Content="{DynamicResource Nav_AiArt}" Margin="0,0,4,0" Style="{StaticResource RoomButtonStyle}" Click="RoomAiArt_Click" />
                    </StackPanel>
                </ScrollViewer>

                <!-- ズームおよび設定 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button Content="-" ToolTip="{DynamicResource Nav_ZoomOut}" Width="28" Height="30" Margin="0,0,2,0" Style="{StaticResource NavButtonStyle}" Click="ZoomOut_Click" />
                    <Button x:Name="ZoomLevelButton" Content="100%" ToolTip="{DynamicResource Nav_ZoomReset}" MinWidth="48" Height="30" Margin="0,0,2,0" Style="{StaticResource NavButtonStyle}" Click="ZoomReset_Click" />
                    <Button Content="+" ToolTip="{DynamicResource Nav_ZoomIn}" Width="28" Height="30" Margin="0,0,8,0" Style="{StaticResource NavButtonStyle}" Click="ZoomIn_Click" />

                    <Button Content="⚙" ToolTip="{DynamicResource Nav_Settings}" Width="32" Height="30" Style="{StaticResource NavButtonStyle}" Click="SettingsButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- WebView2 コントロール -->
        <wv2:WebView2 x:Name="MainWebView" Grid.Row="1" />

        <!-- ページ読み込み中インジケータ -->
        <ProgressBar x:Name="LoadingProgressBar" Grid.Row="2" Height="3" IsIndeterminate="True" Visibility="Collapsed" Foreground="{StaticResource BrandPrimaryBrush}" Background="Transparent" BorderThickness="0" />
    </Grid>
</Window>
